package net.pulautin.ontotool;

import java.io.File;
import java.io.InputStream;

import com.hp.hpl.jena.ontology.OntModel;
import com.hp.hpl.jena.ontology.impl.OntModelImpl;
import com.hp.hpl.jena.rdf.model.ModelFactory;
import com.hp.hpl.jena.rdf.model.Property;
import com.hp.hpl.jena.rdf.model.RDFNode;
import com.hp.hpl.jena.rdf.model.Resource;
import com.hp.hpl.jena.rdf.model.Statement;
import com.hp.hpl.jena.rdf.model.StmtIterator;

public class OntoReader {

	public OntoReader() {
		// TODO Auto-generated constructor stub
	}

	/**
	 * @param args
	 */
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		if(args.length != 2) {
			System.err.println("usage: ontoread file lang");
			return;
		}
		
		OntModel om = ModelFactory.createOntologyModel();
		String lang = args[1];
		String path = args[0];
		om.read((new File(path)).toURI().toString(),lang);
		
		StmtIterator si = om.listStatements();
		while(si.hasNext()){
			Statement s = si.nextStatement();
			Resource r = s.getSubject();
			Property p = s.getPredicate();
			RDFNode o = s.getObject();
			
			String row = "\""+nodeToString(r)+"\", "+
				"\""+nodeToString(p)+"\", "+
				"\""+nodeToString(o)+"\"";
			
			System.out.println(row);
		}
		

	}

	private static String nodeToString(RDFNode o) {
		
		if (o.isLiteral()) 
			return o.toString().replaceAll("\\\"", "");
	
		
		if (o.isAnon()) 
			return o.toString();
		
		
		if (o.canAs(Resource.class))
			return o.as(Resource.class).getString();
		
		return "unknown";
	}

}
